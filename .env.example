# Copiar a .env.local y completar. NO commitear .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Umbrales de alerta de vencimiento (horas) — §3
NEXT_PUBLIC_ALERTA_HORAS_AMARILLO=48
NEXT_PUBLIC_ALERTA_HORAS_NARANJA=24

# Envío del informe por correo (§4.1) — Gmail / Google Workspace vía SMTP.
# Sin estas dos variables la app NO envía correo (lanza error, no un falso éxito).
# SMTP_USER: la casilla de correo real de la empresa (ej. informes@empresa.cl)
# SMTP_PASSWORD: una "contraseña de aplicación" de Google (NO la contraseña normal
#   de la cuenta). Se genera en la Cuenta de Google > Seguridad > Contraseñas de
#   aplicaciones (requiere verificación en 2 pasos activada).
SMTP_USER=
SMTP_PASSWORD=
# Opcionales (por defecto smtp.gmail.com : 465 secure, y from = SMTP_USER):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_FROM=Cordillera M&P <informes@empresa.cl>
