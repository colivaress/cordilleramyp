# Copia este archivo a .env.local y completa con los valores de CADA
# ambiente. Nunca subas .env.local, .env.staging ni .env.production al
# repositorio — ya están en .gitignore (confirmado).

# --- Local (valores que imprime `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Staging (proyecto Supabase de staging, no el de producción) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<proyecto-staging>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Producción (proyecto Supabase actual) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<proyecto-produccion>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Umbrales de alerta de vencimiento (horas) — §3
NEXT_PUBLIC_ALERTA_HORAS_AMARILLO=48
NEXT_PUBLIC_ALERTA_HORAS_NARANJA=24

# Envío del informe por correo (§4.1) — Gmail / Google Workspace vía SMTP.
# Sin estas dos variables la app NO envía correo (lanza error, no un falso éxito).
# SMTP_USER: la casilla de correo real de la empresa (ej. informes@empresa.cl)
# SMTP_PASSWORD: una "contraseña de aplicación" de Google (NO la contraseña normal
#   de la cuenta). Se genera en la Cuenta de Google > Seguridad > Contraseñas de
#   aplicaciones (requiere verificación en 2 pasos activada).
SMTP_USER=
SMTP_PASSWORD=
# Opcionales (por defecto smtp.gmail.com : 465 secure, y from = SMTP_USER):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_FROM=Cordillera M&P <informes@empresa.cl>

# Aviso automático por WhatsApp cuando un ticket pasa a "naranjo" (≤24h) — §3.1.
# WhatsApp Business Cloud API de Meta. Solo se leen en el Route Handler del cron
# (server-only), NUNCA en el cliente ni con prefijo NEXT_PUBLIC_.
#
# WHATSAPP_TOKEN: token de acceso PERMANENTE de Meta for Developers (no el
#   temporal de 24 h que Meta da al empezar a probar).
# WHATSAPP_PHONE_NUMBER_ID: id del número de WhatsApp Business (Meta > WhatsApp Manager).
# La plantilla pre-aprobada debe tener 5 variables de cuerpo, en este orden:
#   {{1}} Nro de Inspección · {{2}} Nro de Revisión · {{3}} Patente Camión ·
#   {{4}} Patente Rampla · {{5}} tiempo restante (texto).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcionales (por defecto plantilla "alerta_vencimiento", idioma "es"):
# WHATSAPP_TEMPLATE=alerta_vencimiento
# WHATSAPP_LANG=es

# Protege /api/cron/alertas-whatsapp. Vercel Cron manda automáticamente
# "Authorization: Bearer $CRON_SECRET" si esta variable está definida en el
# proyecto. Sin ella, el endpoint responde 401 a todo.
CRON_SECRET=

# service_role de Supabase — SOLO para el cron server-only (bypassa RLS para
# recorrer todos los tickets y marcar el aviso enviado). NUNCA en el cliente ni
# con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# §3.2 — URL pública de la app (para el botón "Ver inspección" de los correos
# automáticos de vencimiento a los administradores). Lleva prefijo NEXT_PUBLIC_
# porque arma un link absoluto dentro del HTML del correo; no es un secreto.
NEXT_PUBLIC_APP_URL=https://cordilleramyp.vercel.app
