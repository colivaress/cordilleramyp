# Copiar a .env.local y completar. NO commitear .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Umbrales de alerta de vencimiento (horas) — §3
NEXT_PUBLIC_ALERTA_HORAS_AMARILLO=48
NEXT_PUBLIC_ALERTA_HORAS_NARANJA=24

# Envío del informe por correo (§4.1). Si no se define SMTP_HOST, el envío usa
# una cuenta de prueba Ethereal (no entrega real, deja una URL para ver el correo
# y su PDF adjunto). Para producción, configurar un SMTP real:
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# MAIL_FROM=Cordillera M&P <informes@cordilleramyp.cl>
