{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Habilita import con extensión ".ts" real (ej. src/lib/patentes.test.ts
    // importando "./patentes.ts") — hace falta para correr un archivo de
    // prueba con `node --test` directo (la resolución ESM nativa de Node
    // exige una extensión real y resolvible, a diferencia del resto del
    // proyecto que usa el resolver de Next/bundler). Requiere `noEmit`
    // (ya está arriba); no cambia nada del build de Next, que resuelve
    // módulos con su propio bundler, no con tsc.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "scripts"]
}
